 121:My_Top/Motor_Control/my_tim.cpp **** void My_Tim::OC_Callback()
 122:My_Top/Motor_Control/my_tim.cpp **** {
 123:My_Top/Motor_Control/my_tim.cpp ****     _oc_count = (_oc_count % 16000) + 1;
 124:My_Top/Motor_Control/my_tim.cpp **** 
 125:My_Top/Motor_Control/my_tim.cpp ****     FOC_Motor* m = _motor;
 126:My_Top/Motor_Control/my_tim.cpp **** 
 127:My_Top/Motor_Control/my_tim.cpp ****     if (!m->control_init_flag) return;
 128:My_Top/Motor_Control/my_tim.cpp **** 
 129:My_Top/Motor_Control/my_tim.cpp ****     if (_oc_count % FOC_CURRRENT_LOOP_FREQ_DIV == 0)
 130:My_Top/Motor_Control/my_tim.cpp ****     {
 131:My_Top/Motor_Control/my_tim.cpp ****         m->Update_FOC_Current();
 132:My_Top/Motor_Control/my_tim.cpp ****         if (m->work_mode == Ia_loop || m->work_mode == speed_loop || m->work_mode == position_loop)
 133:My_Top/Motor_Control/my_tim.cpp ****         {
 134:My_Top/Motor_Control/my_tim.cpp ****             // uint32_t start_time = HAL_System::get_tick_us();
 135:My_Top/Motor_Control/my_tim.cpp ****             m->FOC_Current_Loop(); //耗时12us  
 136:My_Top/Motor_Control/my_tim.cpp ****             // m->laji = (float)(HAL_System::get_tick_us() - start_time);
 137:My_Top/Motor_Control/my_tim.cpp ****         }
 138:My_Top/Motor_Control/my_tim.cpp ****     }
 139:My_Top/Motor_Control/my_tim.cpp ****     if ( m->work_mode == CurrentCalibration && _oc_count % Calibration_DIV == 0)
 140:My_Top/Motor_Control/my_tim.cpp ****     {
 141:My_Top/Motor_Control/my_tim.cpp ****         
 142:My_Top/Motor_Control/my_tim.cpp ****         if(m->Calibration_Cnt < ((uint16_t)(CALIBRATION_FREQ_HZ/10.0f+0.5f)+1))//100ms内
 143:My_Top/Motor_Control/my_tim.cpp ****         {
 144:My_Top/Motor_Control/my_tim.cpp ****             m->Current_Auto_Calibration(true);//保证100us以上
 145:My_Top/Motor_Control/my_tim.cpp ****         }else
 146:My_Top/Motor_Control/my_tim.cpp ****         {
