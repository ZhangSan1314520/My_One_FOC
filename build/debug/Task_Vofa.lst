  32:My_Top/MC/My_Vofa.hpp **** struct VoFA_Rx {
  33:My_Top/MC/My_Vofa.hpp ****     uint8_t      rx_buf[VOFA_RX_BUF_SIZE]; // DMA 原始数据
  34:My_Top/MC/My_Vofa.hpp ****     uint16_t     rx_len;                    // 本帧字节数
  35:My_Top/MC/My_Vofa.hpp ****     volatile bool rx_ready;                 // 中断置1，Task清0
  36:My_Top/MC/My_Vofa.hpp **** 
  37:My_Top/MC/My_Vofa.hpp ****     vofa_param_t params[VOFA_PARAM_MAX];   // 参数表
