  39:My_Top/MC/My_Vofa.hpp **** 
  40:My_Top/MC/My_Vofa.hpp ****     /* 中断里调：拷贝数据到队列，替代 rx_ready 标志位 */
  41:My_Top/MC/My_Vofa.hpp ****     void on_recv(uint8_t *buf, uint16_t len) {
  42:My_Top/MC/My_Vofa.hpp ****         VofaRxFrame_t frame;
  43:My_Top/MC/My_Vofa.hpp ****         if (len > VOFA_RX_BUF_SIZE) len = VOFA_RX_BUF_SIZE;
  44:My_Top/MC/My_Vofa.hpp ****         frame.len = len;
  45:My_Top/MC/My_Vofa.hpp ****         memcpy(frame.buf, buf, len);
  46:My_Top/MC/My_Vofa.hpp ****         
  47:My_Top/MC/My_Vofa.hpp ****         BaseType_t xHigherPriorityTaskWoken = pdFALSE; //中断里向队列发消息的标准三板
  48:My_Top/MC/My_Vofa.hpp ****         xQueueSendFromISR(vofaRxQueue, &frame, &xHigherPriorityTaskWoken);
  49:My_Top/MC/My_Vofa.hpp ****         portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
  50:My_Top/MC/My_Vofa.hpp ****     }
  51:My_Top/MC/My_Vofa.hpp **** 
  52:My_Top/MC/My_Vofa.hpp **** 
  53:My_Top/MC/My_Vofa.hpp ****     /* Task 里调：解析 "name:value\n" */
  54:My_Top/MC/My_Vofa.hpp ****     void parse() {
  55:My_Top/MC/My_Vofa.hpp ****         char name[VOFA_NAME_LEN] = {}, val[16] = {};     // 临时缓冲区  
  56:My_Top/MC/My_Vofa.hpp ****         uint8_t ni = 0, vi = 0;                          // name/val 索引
  57:My_Top/MC/My_Vofa.hpp ****         bool in_val = false;                            // false=读名 true=读值
  58:My_Top/MC/My_Vofa.hpp **** 
  59:My_Top/MC/My_Vofa.hpp ****         for (uint16_t i = 0; i < rx_len; i++) {          // 逐字节扫描
  60:My_Top/MC/My_Vofa.hpp ****             char c = (char)rx_buf[i];
  61:My_Top/MC/My_Vofa.hpp ****             if (!in_val) {                                // 读参数名阶段
  62:My_Top/MC/My_Vofa.hpp ****                 if (c == ':') { name[ni] = '\0'; in_val = true; } // 遇到':'切换
  63:My_Top/MC/My_Vofa.hpp ****                 else if (ni < VOFA_NAME_LEN - 1) name[ni++] = c;
  64:My_Top/MC/My_Vofa.hpp ****             } else {                                      // 读参数值阶段
  65:My_Top/MC/My_Vofa.hpp ****                 if (c == '\n') {                          // 遇到'\n'本条结束
  66:My_Top/MC/My_Vofa.hpp ****                     val[vi] = '\0';
  67:My_Top/MC/My_Vofa.hpp ****                     vofa_param_t *p = _find(name);       // 查表  p 指向 params
  68:My_Top/MC/My_Vofa.hpp ****                     if (p) { p->value = atof(val); p->valid = true; } //将字符串转浮点数 �
  69:My_Top/MC/My_Vofa.hpp ****                     memset(name, 0, sizeof(name));       // 重置，准备下一条
  70:My_Top/MC/My_Vofa.hpp ****                     ni = vi = 0; in_val = false; //清零重新读名
  71:My_Top/MC/My_Vofa.hpp ****                 } else if (vi < 15) val[vi++] = c;        // 存值
  72:My_Top/MC/My_Vofa.hpp ****             }
  73:My_Top/MC/My_Vofa.hpp ****         }
  74:My_Top/MC/My_Vofa.hpp ****         
  75:My_Top/MC/My_Vofa.hpp ****     }
  76:My_Top/MC/My_Vofa.hpp **** 
