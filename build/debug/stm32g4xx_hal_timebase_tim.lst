 107:Core/Src/stm32g4xx_hal_timebase_tim.c **** /**
 108:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @brief  Suspend Tick increment.
 109:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @note   Disable the tick increment by disabling TIM20 update interrupt.
 110:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @param  None
 111:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @retval None
 112:Core/Src/stm32g4xx_hal_timebase_tim.c ****   */
 113:Core/Src/stm32g4xx_hal_timebase_tim.c **** void HAL_SuspendTick(void)
 114:Core/Src/stm32g4xx_hal_timebase_tim.c **** {
 115:Core/Src/stm32g4xx_hal_timebase_tim.c ****   /* Disable TIM20 update Interrupt */
 116:Core/Src/stm32g4xx_hal_timebase_tim.c ****   __HAL_TIM_DISABLE_IT(&htim20, TIM_IT_UPDATE);
 117:Core/Src/stm32g4xx_hal_timebase_tim.c **** }
 118:Core/Src/stm32g4xx_hal_timebase_tim.c **** 
 119:Core/Src/stm32g4xx_hal_timebase_tim.c **** /**
 120:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @brief  Resume Tick increment.
 121:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @note   Enable the tick increment by Enabling TIM20 update interrupt.
 122:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @param  None
 123:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @retval None
 124:Core/Src/stm32g4xx_hal_timebase_tim.c ****   */
 125:Core/Src/stm32g4xx_hal_timebase_tim.c **** void HAL_ResumeTick(void)
 126:Core/Src/stm32g4xx_hal_timebase_tim.c **** {
