  33:Core/Src/stm32g4xx_hal_timebase_tim.c **** /**
  34:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @brief  This function configures the TIM20 as a time base source.
  35:Core/Src/stm32g4xx_hal_timebase_tim.c ****   *         The time source is configured  to have 1ms time base with a dedicated
  36:Core/Src/stm32g4xx_hal_timebase_tim.c ****   *         Tick interrupt priority.
  37:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @note   This function is called  automatically at the beginning of program after
  38:Core/Src/stm32g4xx_hal_timebase_tim.c ****   *         reset by HAL_Init() or at any time when clock is configured, by HAL_RCC_ClockConfig().
  39:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @param  TickPriority: Tick interrupt priority.
  40:Core/Src/stm32g4xx_hal_timebase_tim.c ****   * @retval HAL status
  41:Core/Src/stm32g4xx_hal_timebase_tim.c ****   */
  42:Core/Src/stm32g4xx_hal_timebase_tim.c **** HAL_StatusTypeDef HAL_InitTick(uint32_t TickPriority)
  43:Core/Src/stm32g4xx_hal_timebase_tim.c **** {
  44:Core/Src/stm32g4xx_hal_timebase_tim.c ****   RCC_ClkInitTypeDef    clkconfig;
  45:Core/Src/stm32g4xx_hal_timebase_tim.c ****   uint32_t              uwTimclock = 0;
  46:Core/Src/stm32g4xx_hal_timebase_tim.c ****   uint32_t              uwPrescalerValue = 0;
  47:Core/Src/stm32g4xx_hal_timebase_tim.c ****   uint32_t              pFLatency;
  48:Core/Src/stm32g4xx_hal_timebase_tim.c **** 
  49:Core/Src/stm32g4xx_hal_timebase_tim.c ****   HAL_StatusTypeDef     status;
  50:Core/Src/stm32g4xx_hal_timebase_tim.c **** 
  51:Core/Src/stm32g4xx_hal_timebase_tim.c ****   /* Enable TIM20 clock */
  52:Core/Src/stm32g4xx_hal_timebase_tim.c ****   __HAL_RCC_TIM20_CLK_ENABLE();
  53:Core/Src/stm32g4xx_hal_timebase_tim.c **** 
  54:Core/Src/stm32g4xx_hal_timebase_tim.c ****   /* Get clock configuration */
  55:Core/Src/stm32g4xx_hal_timebase_tim.c ****   HAL_RCC_GetClockConfig(&clkconfig, &pFLatency);
  56:Core/Src/stm32g4xx_hal_timebase_tim.c **** 
  57:Core/Src/stm32g4xx_hal_timebase_tim.c ****   /* Compute TIM20 clock */
  58:Core/Src/stm32g4xx_hal_timebase_tim.c ****   uwTimclock = HAL_RCC_GetPCLK2Freq();
  59:Core/Src/stm32g4xx_hal_timebase_tim.c **** 
  60:Core/Src/stm32g4xx_hal_timebase_tim.c ****   /* Compute the prescaler value to have TIM20 counter clock equal to 1MHz */
  61:Core/Src/stm32g4xx_hal_timebase_tim.c ****   uwPrescalerValue = (uint32_t) ((uwTimclock / 1000000U) - 1U);
  62:Core/Src/stm32g4xx_hal_timebase_tim.c **** 
  63:Core/Src/stm32g4xx_hal_timebase_tim.c ****   /* Initialize TIM20 */
  64:Core/Src/stm32g4xx_hal_timebase_tim.c ****   htim20.Instance = TIM20;
  65:Core/Src/stm32g4xx_hal_timebase_tim.c **** 
  66:Core/Src/stm32g4xx_hal_timebase_tim.c ****   /* Initialize TIMx peripheral as follow:
  67:Core/Src/stm32g4xx_hal_timebase_tim.c ****    * Period = [(TIM20CLK/1000) - 1]. to have a (1/1000) s time base.
  68:Core/Src/stm32g4xx_hal_timebase_tim.c ****    * Prescaler = (uwTimclock/1000000 - 1) to have a 1MHz counter clock.
  69:Core/Src/stm32g4xx_hal_timebase_tim.c ****    * ClockDivision = 0
  70:Core/Src/stm32g4xx_hal_timebase_tim.c ****    * Counter direction = Up
  71:Core/Src/stm32g4xx_hal_timebase_tim.c ****    */
  72:Core/Src/stm32g4xx_hal_timebase_tim.c ****   htim20.Init.Period = (1000000U / 1000U) - 1U;
  73:Core/Src/stm32g4xx_hal_timebase_tim.c ****   htim20.Init.Prescaler = uwPrescalerValue;
  74:Core/Src/stm32g4xx_hal_timebase_tim.c ****   htim20.Init.ClockDivision = 0;
  75:Core/Src/stm32g4xx_hal_timebase_tim.c ****   htim20.Init.CounterMode = TIM_COUNTERMODE_UP;
  76:Core/Src/stm32g4xx_hal_timebase_tim.c **** 
  77:Core/Src/stm32g4xx_hal_timebase_tim.c ****   status = HAL_TIM_Base_Init(&htim20);
  78:Core/Src/stm32g4xx_hal_timebase_tim.c ****   if (status == HAL_OK)
  79:Core/Src/stm32g4xx_hal_timebase_tim.c ****   {
  80:Core/Src/stm32g4xx_hal_timebase_tim.c **** 
  81:Core/Src/stm32g4xx_hal_timebase_tim.c ****     /* Start the TIM time Base generation in interrupt mode */
  82:Core/Src/stm32g4xx_hal_timebase_tim.c ****     status = HAL_TIM_Base_Start_IT(&htim20);
  83:Core/Src/stm32g4xx_hal_timebase_tim.c ****     if (status == HAL_OK)
  84:Core/Src/stm32g4xx_hal_timebase_tim.c ****     {
  85:Core/Src/stm32g4xx_hal_timebase_tim.c ****     /* Enable the TIM20 global Interrupt */
  86:Core/Src/stm32g4xx_hal_timebase_tim.c ****         HAL_NVIC_EnableIRQ(TIM20_UP_IRQn);
ARM GAS  /tmp/ccSuXmDa.s 			page 3


  87:Core/Src/stm32g4xx_hal_timebase_tim.c ****       /* Configure the SysTick IRQ priority */
  88:Core/Src/stm32g4xx_hal_timebase_tim.c ****       if (TickPriority < (1UL << __NVIC_PRIO_BITS))
  89:Core/Src/stm32g4xx_hal_timebase_tim.c ****       {
