  29:Lib/compute/pid/foc_math.hpp ****     // Park 变换
  30:Lib/compute/pid/foc_math.hpp ****     // ============================================================
  31:Lib/compute/pid/foc_math.hpp ****     void Park(float sine, float cosine)
  32:Lib/compute/pid/foc_math.hpp ****     {
  33:Lib/compute/pid/foc_math.hpp ****         i_d = i_alpha * cosine + i_beta * sine;
  34:Lib/compute/pid/foc_math.hpp **** 
  35:Lib/compute/pid/foc_math.hpp ****         i_q = -i_alpha * sine + i_beta * cosine;
  36:Lib/compute/pid/foc_math.hpp ****     }
  37:Lib/compute/pid/foc_math.hpp **** 
  38:Lib/compute/pid/foc_math.hpp **** 
  39:Lib/compute/pid/foc_math.hpp **** 
  40:Lib/compute/pid/foc_math.hpp ****     // ============================================================
  41:Lib/compute/pid/foc_math.hpp ****     // Park逆变换
  42:Lib/compute/pid/foc_math.hpp ****     // ============================================================
  43:Lib/compute/pid/foc_math.hpp ****     void IPark(float ud, float uq, float sine, float cosine)
  44:Lib/compute/pid/foc_math.hpp ****     {
  45:Lib/compute/pid/foc_math.hpp ****         u_d = ud;
  46:Lib/compute/pid/foc_math.hpp ****         u_q = uq;
  47:Lib/compute/pid/foc_math.hpp **** 
  48:Lib/compute/pid/foc_math.hpp ****         u_alpha = u_d * cosine - u_q * sine;
  49:Lib/compute/pid/foc_math.hpp **** 
  50:Lib/compute/pid/foc_math.hpp ****         u_beta = u_d * sine + u_q * cosine;
  51:Lib/compute/pid/foc_math.hpp ****     } 
