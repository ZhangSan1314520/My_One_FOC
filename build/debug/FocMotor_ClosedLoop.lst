  13:Lib/compute/pid/foc_math.hpp ****     // Clarke 克拉克变换
  14:Lib/compute/pid/foc_math.hpp ****     // ============================================================
  15:Lib/compute/pid/foc_math.hpp ****     void Clarke(float ia, float ib)
  16:Lib/compute/pid/foc_math.hpp ****     {
  17:Lib/compute/pid/foc_math.hpp ****         i_a = ia;
  18:Lib/compute/pid/foc_math.hpp ****         i_b = ib;
  19:Lib/compute/pid/foc_math.hpp **** 
  20:Lib/compute/pid/foc_math.hpp ****         i_alpha = i_a;
  21:Lib/compute/pid/foc_math.hpp **** 
  22:Lib/compute/pid/foc_math.hpp ****         // i_beta = (i_a + 2*i_b) / √3
  23:Lib/compute/pid/foc_math.hpp ****         i_beta = i_a * M_SQRT3_3 + i_b * M_2SQRT3_3;
  24:Lib/compute/pid/foc_math.hpp ****     }
  25:Lib/compute/pid/foc_math.hpp **** 
  26:Lib/compute/pid/foc_math.hpp **** 
  27:Lib/compute/pid/foc_math.hpp **** 
