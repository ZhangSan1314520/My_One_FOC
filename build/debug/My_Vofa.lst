   3:My_Top/MC/My_Vofa.cpp **** 
   4:My_Top/MC/My_Vofa.cpp **** // 1.发送部分
   5:My_Top/MC/My_Vofa.cpp **** // 定义双缓冲区，防止连续发送时覆盖 
   6:My_Top/MC/My_Vofa.cpp **** #define MAX_VOFA_FLOATS 30 // 临时缓冲区，最多发送 30 个浮点数 
   7:My_Top/MC/My_Vofa.cpp **** #define VOFA_BUFFER_SIZE (MAX_VOFA_FLOATS * sizeof(float) + 4)  // 最多20个浮点数 + 4字节�
   8:My_Top/MC/My_Vofa.cpp **** static uint8_t vofa_buf1[VOFA_BUFFER_SIZE];
   9:My_Top/MC/My_Vofa.cpp **** static uint8_t vofa_buf2[VOFA_BUFFER_SIZE];
  10:My_Top/MC/My_Vofa.cpp **** static uint8_t vofa_buf_sel = 0;  // 简单轮换选择
  11:My_Top/MC/My_Vofa.cpp **** 
ARM GAS  /tmp/ccOxeCZx.s 			page 4


  12:My_Top/MC/My_Vofa.cpp **** static const uint8_t tail[4] = {0x00, 0x00, 0x80, 0x7F};
  13:My_Top/MC/My_Vofa.cpp **** 
  14:My_Top/MC/My_Vofa.cpp **** void Vofa_SendFireWater(UART_HandleTypeDef *huart,float *data, uint16_t count, uint32_t timeout)//�
  15:My_Top/MC/My_Vofa.cpp **** {
  16:My_Top/MC/My_Vofa.cpp ****     if (count == 0) return;
  17:My_Top/MC/My_Vofa.cpp ****     uint16_t data_len = count * sizeof(float);
  18:My_Top/MC/My_Vofa.cpp ****     uint16_t total_len = data_len + 4;
  19:My_Top/MC/My_Vofa.cpp **** 
  20:My_Top/MC/My_Vofa.cpp ****     // 选择当前可用的缓冲区（简单轮换，确保不覆盖正在DMA发送中的数据�
  21:My_Top/MC/My_Vofa.cpp ****     uint8_t *buf = (vofa_buf_sel == 0) ? vofa_buf1 : vofa_buf2;
  22:My_Top/MC/My_Vofa.cpp ****     vofa_buf_sel = !vofa_buf_sel;  // 下次用另一个
  23:My_Top/MC/My_Vofa.cpp **** 
  24:My_Top/MC/My_Vofa.cpp ****     // 拼接数据
  25:My_Top/MC/My_Vofa.cpp ****     memcpy(buf, data, data_len);
  26:My_Top/MC/My_Vofa.cpp ****     memcpy(buf + data_len, tail, 4);
  27:My_Top/MC/My_Vofa.cpp ****  
  28:My_Top/MC/My_Vofa.cpp ****     if (timeout == 0) HAL_UART_Transmit_DMA(huart, buf, total_len);//DMA 发送
  29:My_Top/MC/My_Vofa.cpp ****     else HAL_UART_Transmit(huart, (uint8_t*)buf, total_len, timeout); //轮询发送
  30:My_Top/MC/My_Vofa.cpp **** }
  31:My_Top/MC/My_Vofa.cpp **** 
  32:My_Top/MC/My_Vofa.cpp **** 
  33:My_Top/MC/My_Vofa.cpp **** 
  34:My_Top/MC/My_Vofa.cpp **** void Vofa_SendFireWater_VA(UART_HandleTypeDef *huart,uint16_t count, ...)//发送不定长浮点型
  35:My_Top/MC/My_Vofa.cpp **** {
  36:My_Top/MC/My_Vofa.cpp ****     float buffer[MAX_VOFA_FLOATS];
  37:My_Top/MC/My_Vofa.cpp ****     
  38:My_Top/MC/My_Vofa.cpp ****     if (count > MAX_VOFA_FLOATS) count = MAX_VOFA_FLOATS;  // 防溢出
  39:My_Top/MC/My_Vofa.cpp ****     
  40:My_Top/MC/My_Vofa.cpp ****     va_list args;
  41:My_Top/MC/My_Vofa.cpp ****     va_start(args, count); //让 args 指向第一个可变参数
  42:My_Top/MC/My_Vofa.cpp ****     for (uint16_t i = 0; i < count; i++) {//取出下一个参数
  43:My_Top/MC/My_Vofa.cpp ****         buffer[i] = (float)va_arg(args, double);  // 变参 float 会被提升为 double
  44:My_Top/MC/My_Vofa.cpp ****     }
  45:My_Top/MC/My_Vofa.cpp ****     va_end(args);
  46:My_Top/MC/My_Vofa.cpp ****     
  47:My_Top/MC/My_Vofa.cpp ****     Vofa_SendFireWater(huart, buffer, count,0);//dma发送
  48:My_Top/MC/My_Vofa.cpp **** }
  49:My_Top/MC/My_Vofa.cpp **** 
